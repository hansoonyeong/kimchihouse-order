# Vercel 배포 시 환경변수 (Settings → Environment Variables)
# 로컬에서 배포 주문/재고를 같이 보려면 아래 값을 .env 로 복사하세요.

# 필수 — 관리자 로그인 비밀번호 (admin.html)
ADMIN_PASSWORD=your-admin-password-here

# 필수 — 주문 API 검증 키 (/api/config, /api/orders)
ORDER_SECRET=your-order-secret-here

# 필수 — Upstash Redis (배포 주문 저장소). Vercel 프로젝트 Environment Variables에서 복사
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 또는
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
