{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/walkerhill", "destination": "/index.html" },
    { "source": "/walkerhill/", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "includeFiles": "api/_*/**"
    }
  }
}
